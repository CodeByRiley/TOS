module demo;
import std.stdio;

U0 Banner() {
    "HolyC-style string statement\n";
}

void main() {
    I64[] nums = [0x10, 20, 30];
    long total = 0;

    foreach (i, I64 n; nums) {
        writeln("nums[", i, "] = ", n);
        total = total + nums[i];
    }

    nums = nums ~ [40, 50];

    for (I64 j = 3; j < nums.length; j++) {
        total = total + nums[j];
    }

    I64 countdown = 2;
    while (countdown > 0) {
        countdown--;
    }

    Banner;
    writeln("len=", nums.length, " total=", total, " countdown=", countdown);
}
