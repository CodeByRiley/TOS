U8 main() {
  I64 sock = UdpSocket();

  if (sock == 0) {
    PrintLn("Failed to create socket!");
    return -1;
  }

  UdpBind(sock, 6000);

  I64[] ip = [10, 0, 2, 2];

  UdpSend(sock, "Hello from HolyD!", ip, 6000);
  PrintLn("Sent packet, waiting for reply...");

  auto reply = "";
  while (reply.length == 0) {
    reply = UdpReceive(sock);
  }

  Print("Got reply: ");
  PrintLn(reply);

  return 0;
}
