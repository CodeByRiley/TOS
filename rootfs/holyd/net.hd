U8 main() {
  I64 sock = UdpSocket();

  if (sock == 0) {
    PrintLn("Failed to create socket!");
    return -1;
  }

  UdpBind(sock, 5000);

  // Dest IP: 10.0.2.2 (QEMU host)
  I64[] ip = [10, 0, 2, 2];

  UdpSend(sock, "Hello from HolyD!", ip, 5000);

  // Wait for a reply
  string reply = UdpReceive(sock);
  Print("Got reply: ");
  PrintLn(reply);

  return 0;
}
