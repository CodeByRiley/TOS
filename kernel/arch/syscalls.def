SYSCALL_BOTH(SHMEM_UNSHARE, 1045)
SYSCALL_BOTH(CON_WRITE, 1060)
SYSCALL_BOTH(CON_CLEAR, 1061)
SYSCALL_BOTH(CON_PUSH, 1062)
SYSCALL_BOTH(CON_POP, 1063)
SYSCALL_BOTH(CON_ZOOM, 1064)
