/* kernel/arch/syscalls.def , the syscall-number registry.
 *
 * Include only after defining SYSCALL_BOTH(name, number),
 * SYSCALL_KERNEL(name, number), and SYSCALL_ALIAS_BOTH(name, target).
 * BOTH entries are exposed by libtos. KERNEL entries are Linux-compatible
 * calls issued directly by musl, so libtos needs no public constant.
 */

SYSCALL_BOTH(READ, 0)
SYSCALL_BOTH(WRITE, 1)
SYSCALL_BOTH(OPEN, 2)
SYSCALL_BOTH(CLOSE, 3)
SYSCALL_BOTH(STAT, 4)
SYSCALL_BOTH(FSTAT, 5)
SYSCALL_BOTH(POLL, 7)
SYSCALL_BOTH(LSEEK, 8)
SYSCALL_BOTH(MMAP, 9)
SYSCALL_BOTH(MPROTECT, 10)
SYSCALL_BOTH(MUNMAP, 11)
SYSCALL_BOTH(BRK, 12)
SYSCALL_BOTH(RT_SIGACTION, 13)
SYSCALL_BOTH(IOCTL, 16)
SYSCALL_BOTH(READV, 19)
SYSCALL_BOTH(WRITEV, 20)
SYSCALL_BOTH(YIELD, 24)
SYSCALL_BOTH(NANOSLEEP, 35)
SYSCALL_BOTH(LINUX_GETPID, 39)
SYSCALL_ALIAS_BOTH(GET_PID, LINUX_GETPID)
SYSCALL_KERNEL(SOCKET, 41)
SYSCALL_KERNEL(SENDTO, 44)
SYSCALL_KERNEL(RECVFROM, 45)
SYSCALL_KERNEL(BIND, 49)
SYSCALL_BOTH(EXIT, 60)
SYSCALL_BOTH(KILL, 62)
SYSCALL_BOTH(UNAME, 63)
SYSCALL_BOTH(FCNTL, 72)
SYSCALL_BOTH(GETCWD, 79)
SYSCALL_BOTH(CHDIR, 80)
SYSCALL_BOTH(MKDIR, 83)
SYSCALL_BOTH(RMDIR, 84)
SYSCALL_BOTH(UNLINK, 87)
SYSCALL_KERNEL(GETTIMEOFDAY, 96)
SYSCALL_BOTH(ARCH_PRCTL, 158)
SYSCALL_KERNEL(FUTEX, 202)
SYSCALL_BOTH(READDIR, 217)
SYSCALL_BOTH(SET_TID_ADDRESS, 218)
SYSCALL_BOTH(CLOCK_GETTIME, 228)
SYSCALL_BOTH(EXIT_GROUP, 231)
SYSCALL_BOTH(FSTATAT, 262)

SYSCALL_BOTH(FB_INFO, 1000)
SYSCALL_BOTH(FB_MAP, 1001)
