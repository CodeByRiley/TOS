# EditorConfig - https://editorconfig.org
#
# This exists for one reason: make requires a literal tab at the start of
# every recipe line, and an editor that helpfully expands tabs turns the
# whole Makefile into "missing separator" errors on the next save.
#
# Indent width for C is deliberately not set. The kernel is two-space and
# userspace is four; declaring a winner here would reformat whichever one
# lost, burying real changes under a whole-tree diff. Only the tab-vs-space
# question is settled, because that one is a correctness issue rather than
# a matter of taste.
#
# end_of_line is likewise omitted: the repo is checked out with
# core.autocrlf, so pinning it here would leave every file permanently
# dirty against what git put on disk.

root = true

[*]
charset = utf-8
insert_final_newline = true

[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab

[*.{c,h,S,asm}]
indent_style = space

[*.py]
indent_style = space
indent_size = 4
