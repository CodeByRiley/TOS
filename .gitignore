.cache/
.ccls-cache/
compile_commands.json
.vs/
.vscode/
.idea/
.claude/
__pycache__/
*.user
*.suo

# Temporary and backup files
*.bak
*.tmp
*.temp
*.log
*~
*.swp
*.swo

