CompileFlags:
  # The generated database is the source of truth for target, language, and
  # include flags.  Keeping those flags out of this file prevents project-wide
  # settings from leaking into host-side tests and tools.
  CompilationDatabase: build
  Add:
    - -ferror-limit=0

Diagnostics:
  UnusedIncludes: None
  Suppress:
    - Wunused-variable
    - Wpointer-to-int-cast
    - Wint-to-void-pointer-cast
    - Wunknown-pragmas
    - Wdiscarded-qualifiers
  ClangTidy:
    Add:
      - bugprone-*
      - performance-*
      - portability-*
    Remove:
      - bugprone-easily-swappable-parameters
      - bugprone-reserved-identifier
      - performance-no-int-to-ptr
